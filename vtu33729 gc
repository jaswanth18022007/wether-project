    {
      "cell_type": "code",
      "source": [
        "rng=random.Random(0)\n",
        "baseline_samples=[sample_reference(rng) for _ in range(200)]\n",
        "baseline_rewards=[gold_reward(s) for s in baseline_samples]\n",
        "for s in baseline_samples[:6]: print(f\"{gold_reward(s):.0f}  {s}\")\n",
        "print(f\"Reference mean reward: {sum(baseline_rewards)/len(baseline_rewards):.3f}\")"
